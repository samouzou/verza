{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "apps/functions",
      "codebase": "default",
      "predeploy": [
        "node scripts/sync-types-into-functions.cjs"
      ],
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ],
      "runtime": "nodejs20"
    }
  ],
  "storage": {
    "rules": "storage.rules"
  },
  "apphosting": {
    "backendId": "studio",
    "rootDir": "apps/web",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "functions",
      ".next",
      ".turbo",
      "dist",
      "out",
      "coverage",
      ".env",
      ".env.*"
    ],
    "alwaysDeployFromSource": true
  },
  "frameworksBackend": {
    "region": "us-central1"
  },
  "emulators": {
    "apphosting": {
      "port": 5002,
      "rootDirectory": "apps/web",
      "startCommand": "npm run dev"
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 8090
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true
  }
}