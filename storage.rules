
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o { // This matches all files in your bucket

    function signedIn() {
      return request.auth != null;
    }

    function requesterProfile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isAgencyOwnerOf(agencyId) {
      return signedIn() &&
             firestore.exists(/databases/(default)/documents/agencies/$(agencyId)) &&
             firestore.get(/databases/(default)/documents/agencies/$(agencyId)).data.ownerId == request.auth.uid;
    }

    function membershipIsActiveTeam(m) {
      return (!('status' in m) || m.status == 'active') &&
             (m.role == 'owner' || m.role == 'admin' || m.role == 'member');
    }

    function hasActiveTeamMembership(agencyId) {
      return signedIn() &&
             firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
             'agencyMemberships' in requesterProfile() &&
             requesterProfile().agencyMemberships.exists(m,
               m.agencyId == agencyId && membershipIsActiveTeam(m)
             );
    }

    function isOnAgencyTeamRoster(agencyId) {
      return signedIn() &&
             firestore.exists(/databases/(default)/documents/agencies/$(agencyId)) &&
             'team' in firestore.get(/databases/(default)/documents/agencies/$(agencyId)).data &&
             firestore.get(/databases/(default)/documents/agencies/$(agencyId)).data.team.exists(t,
               t.userId == request.auth.uid &&
               (!('status' in t) || t.status == 'active') &&
               (t.role == 'admin' || t.role == 'member')
             );
    }

    function hasLegacyPrimaryAccess(agencyId) {
      return signedIn() &&
             firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
             requesterProfile().get('primaryAgencyId', null) == agencyId &&
             (requesterProfile().get('role', '') == 'agency_owner' ||
              requesterProfile().get('role', '') == 'agency_admin' ||
              requesterProfile().get('role', '') == 'agency_member');
    }

    function isTeamMemberOf(agencyId) {
      return isAgencyOwnerOf(agencyId) ||
             hasActiveTeamMembership(agencyId) ||
             isOnAgencyTeamRoster(agencyId) ||
             hasLegacyPrimaryAccess(agencyId);
    }

    // Helper function to check if the requester is part of the specified agency
    function isMemberOfAgency(agencyId) {
      return isTeamMemberOf(agencyId);
    }

    // Agency staff by Firestore memberships (not the selected JWT primaryAgencyId).
    function isAgencyTeamStaffFromProfile() {
      return signedIn() &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        (
          requesterProfile().get('role', '') == 'agency_owner' ||
          requesterProfile().get('role', '') == 'agency_admin' ||
          requesterProfile().get('role', '') == 'agency_member' ||
          (
            'agencyMemberships' in requesterProfile() &&
            requesterProfile().agencyMemberships.exists(m, membershipIsActiveTeam(m))
          )
        );
    }

    function canWriteAgencySharedMedia() {
      return isAgencyTeamStaffFromProfile();
    }

    // Helper to determine if the target user is a talent in the requester's active agency
    function isTalentInMyAgency(targetUserId) {
      let agencyId = requesterProfile().get('primaryAgencyId', request.auth.token.get('primaryAgencyId', null));
      return signedIn() &&
             agencyId != null &&
             firestore.exists(/databases/(default)/documents/agencies/$(agencyId)) &&
             firestore.get(/databases/(default)/documents/agencies/$(agencyId)).data.talent.exists(t, t.userId == targetUserId);
    }

    // Rules for user avatars
    match /avatars/{userId}/{allPaths=**} {
      // Allow public read for avatars (common for profile pictures)
      allow read: if true;
      // Allow authenticated users to write only to their own avatar path
      // And add some constraints on size and type
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 2 * 1024 * 1024 // Max 2MB
                   && request.resource.contentType.matches('image/.*'); // Only image types
    }

    // Rules for company logos
    match /logos/{userId}/{allPaths=**} {
      // Allow public read for logos so they can be displayed on invoices
      allow read: if true;
      // Allow authenticated users to write to their own logo path
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 2 * 1024 * 1024 // Max 2MB
                   && request.resource.contentType.matches('image/.*');
    }

    // Rules for contract files
    // The {ownerId} can be either a user's UID or an agency's ID
    match /contracts/{ownerId}/{allPaths=**} {
      // Allow write if user is writing to their personal folder OR is a member of the agency folder.
      // This covers solo creators, agency owners, and team members.
      allow write: if request.auth != null && (request.auth.uid == ownerId || isMemberOfAgency(ownerId));

      // Read access is simpler. We allow any authenticated user to read,
      // as the sensitive metadata (who can see what) is protected by Firestore rules.
      // The app logic, governed by Firestore queries, will only show the correct files to users.
       allow read: if request.auth != null;
    }
    
    // Rules for receipt images
    match /receipts/{userId}/{fileName} {
      // Allow any authenticated user with the link to read the receipt image.
      // Security is enforced by Firestore rules which control access to the URL itself.
      allow read: if request.auth != null;

      // Allow an authenticated user to write (upload, update, delete) their own receipt images
      // with constraints on file size and type
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 4 * 1024 * 1024 // Max 4MB for receipts
                   && request.resource.contentType.matches('image/.*|application/pdf'); // Allow images and PDFs for receipts
    }

    // Rules for SceneSpawner generated scenes
    match /generated-scenes/{userId}/{fileName} {
      // Allow public read for generated videos
      allow read: if true;
      // Allow authenticated users to write to their own scenes folder
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Rules for gig submissions
    match /submissions/{gigId}/{userId}/{fileName} {
      // Allow creators to upload their own submissions
      // Limit to video types and 100MB for higher quality content
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 100 * 1024 * 1024
                   && request.resource.contentType.matches('video/.*');

      // Creators can read their own submissions, 
      // agency members can read submissions for gigs their agency owns,
      // and managing agents can read submissions for their talent.
      allow read: if request.auth != null && (
        request.auth.uid == userId || 
        isMemberOfAgency(firestore.get(/databases/(default)/documents/gigs/$(gigId)).data.brandId) ||
        isTalentInMyAgency(userId)
      );
    }

    // Rules for brand identity assets (logos, brand guide visuals)
    match /brand_assets/{allPaths=**} {
      // Public read so creators can see the brand deck
      allow read: if true;
      // Allow agency team (profile or JWT claim) to upload
      allow write: if canWriteAgencySharedMedia()
                   && request.resource.size < 50 * 1024 * 1024 // 50MB for brand assets (videos included)
                   && request.resource.contentType.matches('image/.*|video/.*');
    }

    // Rules for product catalog images and videos
    match /products/{allPaths=**} {
      // Public read for creator showcase
      allow read: if true;
      // Allow agency team (profile or JWT claim) to upload
      allow write: if canWriteAgencySharedMedia()
                   && request.resource.size < 50 * 1024 * 1024 // 50MB for products
                   && request.resource.contentType.matches('image/.*|video/.*');
    }

    // Creator Store covers (public) + lesson media uploads
    match /store/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024 // 10MB
                   && request.resource.contentType.matches('image/.*|video/.*|application/pdf');
    }

    // LinkedIn OS carousel slide PNGs (worker writes via Admin SDK; agency team reads)
    match /linkedin_os_carousels/{agencyId}/{allPaths=**} {
      allow read: if request.auth != null && isTeamMemberOf(agencyId);
      allow write: if false;
    }

    // Optic vault creator avatars (Admin SDK write; tokenized read URL; also allow signed-in team)
    match /optic_avatars/{agencyId}/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Rules for high-res B-Roll library
    match /b-roll/{allPaths=**} {
      // Public read so creators can download
      allow read: if true;
      // Allow agency team (profile or JWT claim) to upload
      allow write: if canWriteAgencySharedMedia()
                   && request.resource.size < 100 * 1024 * 1024 // 100MB for high-res b-roll
                   && request.resource.contentType.matches('image/.*|video/.*');
    }
  }
}
