
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the requester is the owner of a document
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    
    function signedIn() {
      return request.auth != null;
    }

    function requesterProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAgencyOwnerOf(agencyId) {
      return signedIn() &&
             exists(/databases/$(database)/documents/agencies/$(agencyId)) &&
             get(/databases/$(database)/documents/agencies/$(agencyId)).data.ownerId == request.auth.uid;
    }

    function isTeamRole() {
      return requesterProfile().get('role', '') == 'agency_owner' ||
             requesterProfile().get('role', '') == 'agency_admin' ||
             requesterProfile().get('role', '') == 'agency_member';
    }

    // Selected workspace only. Clients cannot write primaryAgencyId; switch/accept do it via Admin SDK.
    // Avoid list.exists(item, …) — the deploy linter treats that as invalid even though runtime accepts it.
    function hasSelectedWorkspaceAccess(agencyId) {
      return signedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             requesterProfile().get('primaryAgencyId', null) == agencyId &&
             isTeamRole();
    }

    function isAgencyAdminOf(agencyId) {
      return isAgencyOwnerOf(agencyId) ||
             (hasSelectedWorkspaceAccess(agencyId) && requesterProfile().get('role', '') == 'agency_admin') ||
             (signedIn() &&
              request.auth.token.get('isAgencyAdmin', false) == true &&
              request.auth.token.get('primaryAgencyId', '') == agencyId);
    }

    function isTeamMemberOf(agencyId) {
      return isAgencyOwnerOf(agencyId) || hasSelectedWorkspaceAccess(agencyId);
    }

    function isMemberOfAgency(agencyId) {
      return isTeamMemberOf(agencyId);
    }

    function isTalentInMyAgency(targetUserId) {
      return signedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             exists(/databases/$(database)/documents/users/$(targetUserId)) &&
             requesterProfile().get('primaryAgencyId', request.auth.token.get('primaryAgencyId', null)) != null &&
             (
               get(/databases/$(database)/documents/users/$(targetUserId)).data.get('primaryAgencyId', null) ==
                 requesterProfile().get('primaryAgencyId', request.auth.token.get('primaryAgencyId', null)) ||
               requesterProfile().get('primaryAgencyId', request.auth.token.get('primaryAgencyId', null)) in
                 get(/databases/$(database)/documents/users/$(targetUserId)).data.get('giggingForAgencies', [])
             );
    }

    function isGigAffiliated(userId) {
      return signedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             exists(/databases/$(database)/documents/users/$(userId)) &&
             requesterProfile().get('primaryAgencyId', request.auth.token.get('primaryAgencyId', null)) != null &&
             requesterProfile().get('primaryAgencyId', request.auth.token.get('primaryAgencyId', null)) in
               get(/databases/$(database)/documents/users/$(userId)).data.get('giggingForAgencies', []);
    }

    function isSameAgencyTeam(targetUserId) {
      return signedIn() &&
             exists(/databases/$(database)/documents/users/$(targetUserId)) &&
             get(/databases/$(database)/documents/users/$(targetUserId)).data.get('primaryAgencyId', null) != null &&
             isTeamMemberOf(get(/databases/$(database)/documents/users/$(targetUserId)).data.get('primaryAgencyId', null));
    }

    function requesterPrivilegeFieldsUnchanged() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny([
        'primaryAgencyId',
        'isAgencyOwner',
        'isBrandAccount',
        'role',
        'agencyMemberships',
        'storeSellerStatus',
        'storeSellerSubmittedAt',
        'storeSellerReviewedAt',
        'storeSellerReviewedBy',
        'storeSellerReviewNote',
        'storeSellerRejectReason'
      ]);
    }

    function isMissingFieldBackfill() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny(['primaryAgencyId', 'isAgencyOwner', 'isBrandAccount']) &&
             (!changed.hasAny(['role']) || (!('role' in resource.data) && request.resource.data.role == 'individual_creator')) &&
             (!changed.hasAny(['agencyMemberships']) || (!('agencyMemberships' in resource.data) && request.resource.data.agencyMemberships.size() == 0));
    }

    function isOnboardingCompletion() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return resource.data.get('hasCompletedOnboarding', false) == false &&
             request.resource.data.get('hasCompletedOnboarding', false) == true &&
             changed.hasOnly(['hasCompletedOnboarding', 'role', 'isBrandAccount', 'referralSource']) &&
             (request.resource.data.role == 'individual_creator' || request.resource.data.role == 'agency_owner');
    }

    // Helper to check if a user can access a receipt, either by being the owner
    // or by having access to the linked contract.
    function isAllowedToAccessReceipt(receipt) {
      // The user is the direct owner/creator of the receipt.
      let isDirectOwner = isOwner(receipt.userId);
      // The user has access to the contract this receipt is linked to.
      let hasAccessViaContract = receipt.get('linkedContractId', null) != null ? (request.auth.uid in get(/databases/$(database)/documents/contracts/$(receipt.linkedContractId)).data.get('access', {})) : false;
      
      return isDirectOwner || hasAccessViaContract;
    }

    // Rules for the users collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isTalentInMyAgency(userId) || isGigAffiliated(userId) || isSameAgencyTeam(userId) || resource.data.get('showInMarketplace', false) == true;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && (requesterPrivilegeFieldsUnchanged() || isOnboardingCompletion() || isMissingFieldBackfill());
      
      match /private_credentials/{credId} {
          allow read, write: if false; // Only backend functions
      }

      match /characters/{characterId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Rules for the contracts collection
    match /contracts/{contractId} {
        allow read: if isOwner(resource.data.userId) || request.auth.uid in resource.data.access;
        allow update, delete: if isOwner(resource.data.userId) || request.auth.uid in resource.data.access;
        allow create: if isOwner(request.resource.data.userId) || request.auth.uid in request.resource.data.access;
    }
    
    // Rules for video generations
    match /generations/{generationId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if false;
    }

    // Rules for gigs
    match /gigs/{gigId} {
      allow read: if request.auth != null;
      allow create: if isTeamMemberOf(request.resource.data.brandId);
      allow update: if (isTeamMemberOf(resource.data.brandId)) ||
                       (request.auth != null && resource.data.status == 'open' &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acceptedCreatorIds', 'appliedCreatorIds', 'acceptedAt', 'assignments', 'updatedAt', 'status', 'agentIds']));
      allow delete: if isTeamMemberOf(resource.data.brandId) && 
                      (resource.data.status == 'pending_payment' || 
                       (resource.data.status == 'open' && resource.data.acceptedCreatorIds.size() == 0));
    }

    // Rules for gig submissions
    match /submissions/{submissionId} {
      allow read: if request.auth != null && (
        resource.data.creatorId == request.auth.uid || 
        isTeamMemberOf(resource.data.brandId) ||
        isTalentInMyAgency(resource.data.creatorId) ||
        (resource.data.get('gigId', null) != null && request.auth.uid in get(/databases/$(database)/documents/gigs/$(resource.data.gigId)).data.get('agentIds', []))
      );
      allow create: if request.auth != null && request.resource.data.creatorId == request.auth.uid;
      allow update: if request.auth != null && (
        (resource.data.creatorId == request.auth.uid && request.resource.data.brandId == resource.data.brandId) ||
        (isTeamMemberOf(resource.data.brandId))
      );
    }

    // Rules for affiliate links
    match /affiliateLinks/{linkId} {
      // Public needs to read to get the destination URL for redirect
      // Auth users need to read to see metrics in their dashboard
      allow read: if true; 
      
      // Creators or their agents create their links when securing a deployment
      allow create: if request.auth != null && (request.resource.data.creatorId == request.auth.uid || isTalentInMyAgency(request.resource.data.creatorId));
      
      // Publicly allowed to increment clicks, but nothing else
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks']);
      
      allow delete: if false;
    }

    // Rules for notifications
    match /notifications/{notificationId} {
      allow read, delete: if isOwner(resource.data.userId) || 
                          (resource.data.get('agencyId', null) != null && isMemberOfAgency(resource.data.agencyId));
      allow update: if (isOwner(resource.data.userId) || (resource.data.get('agencyId', null) != null && isMemberOfAgency(resource.data.agencyId))) && 
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create: if request.auth != null; // Triggered by users/agencies
    }

    // Rules for brand_research collection
    match /brand_research/{researchId} {
      allow read, update, delete: if isOwner(resource.data.uid);
      allow create: if isOwner(resource.data.uid);
    }

    // YouTube Writer saved drafts (creators)
    match /youtube_writer_drafts/{draftId} {
      allow read, update, delete: if isOwner(resource.data.uid);
      allow create: if isOwner(request.resource.data.uid)
        && request.resource.data.keys().hasAll(['uid', 'videoId', 'youtubeUrl', 'prompt', 'text', 'createdAt', 'updatedAt']);
    }
    
    // Rules for credit transactions collection
    match /credit_transactions/{transactionId} {
      allow read: if isOwner(resource.data.userId);
      allow write: if false; // Only backend can write
    }

    match /paymentIntents/{intentId} {
      allow read: if isOwner(resource.data.userId) || isOwner(resource.data.creatorId);
      allow create, update, delete: if false;
    }
    
    // Rules for payments
    match /payments/{paymentId} {
       allow read: if isOwner(resource.data.userId) || isOwner(resource.data.creatorId);
      allow create, update, delete: if false;
    }
    
    match /emailLogs/{logId} {
      allow read: if resource.data.get('contractId', null) != null && 
                     get(/databases/$(database)/documents/contracts/$(resource.data.contractId)).data.access[request.auth.uid] != null;
      allow write: if false;
    }
    
    match /users/{userId}/bankAccounts/{accountId} {
      allow read, write: if isOwner(userId);
    }
    
    match /users/{userId}/bankTransactions/{transactionId} {
      allow read, write: if isOwner(userId);
    }
    
    match /receipts/{receiptId} {
      allow get, delete: if isAllowedToAccessReceipt(resource.data);
      allow list: if request.auth != null;
      allow create: if isAllowedToAccessReceipt(request.resource.data);
      allow update: if isAllowedToAccessReceipt(resource.data) && isAllowedToAccessReceipt(request.resource.data);
    }
    
    match /agencies/{agencyId} {
      allow read: if request.auth != null;
      allow create: if isOwner(request.resource.data.ownerId);
      // Team access is membership-based so switching workspaces does not require a JWT refresh.
      allow update: if (isTeamMemberOf(agencyId) || isMemberOfAgency(agencyId))
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'opticCreditsBalance',
          'opticPlan',
          'opticSubscriptionStatus',
          'opticStripeSubscriptionId',
          'opticBillingInterval',
          'opticPeriodEnd',
          'opticMonthlyAllowance',
          'opticOverageLeadsThisPeriod',
          'opticTopUpBlocksThisPeriod',
          'opticLowCreditWarningPeriodKey',
          'opticBillingSource',
          'appsumoOpticCodeCount',
          'opticAppsumoPeriodKey'
        ]);
      allow delete: if get(/databases/$(database)/documents/agencies/$(agencyId)).data.ownerId == request.auth.uid;
    }

    match /appsumo_optic_codes/{codeId} {
      allow read, write: if false;
    }
    
    match /internalPayouts/{payoutId} {
      allow read: if isMemberOfAgency(resource.data.agencyId) || isOwner(resource.data.talentId);
      allow create: if isAgencyAdminOf(request.resource.data.agencyId);
      allow update, delete: if false;
    }
    
     match /agencyInvitations/{invitationId} {
        allow read: if request.auth.uid != null;
        allow write: if false;
     }
     
     match /teamInvitations/{invitationId} {
        allow read: if request.auth.uid != null;
        allow write: if false;
     }

    // Optic cloud discovery jobs (written by Cloud Functions; clients read for status)
    match /optic_jobs/{jobId} {
      allow read: if request.auth != null && isTeamMemberOf(resource.data.agencyId);
      allow write: if false;
    }

    // Optic outreach leads vault (written by Optic desktop or worker; team reads)
    match /optic_outreach_leads/{leadId} {
      allow read: if request.auth != null &&
        resource.data.get('agencyId', null) != null &&
        isTeamMemberOf(resource.data.agencyId);
      allow write: if false;
    }

    // Optic credit charge ledger (Admin SDK only; prevents double-charge on retries)
    match /optic_credit_charges/{chargeId} {
      allow read, write: if false;
    }

    match /optic_top_up_events/{eventId} {
      allow read, write: if false;
    }

    // MCP personal API keys (Admin SDK / callables only — never client-readable)
    match /mcp_api_keys/{keyId} {
      allow read, write: if false;
    }

    // LinkedIn OS — company LinkedIn draft jobs (worker writes; agency team reads)
    match /linkedin_os_jobs/{jobId} {
      allow read: if request.auth != null &&
        (resource.data.createdBy == request.auth.uid ||
          (resource.data.get('agencyId', null) != null &&
            isTeamMemberOf(resource.data.agencyId)));
      allow write: if false;
    }

    match /linkedin_os_prompts/{docId} {
      allow read, write: if false;
    }

    // LinkedIn Strategist — learned voice per agency (Admin writes via callable)
    match /linkedin_os_voice_profiles/{agencyId} {
      allow read: if request.auth != null && isTeamMemberOf(agencyId);
      allow write: if false;
    }

    // Creator Store — digital products sold to fans via Connect checkout
    match /storeProducts/{productId} {
      allow read: if resource.data.status == "active" ||
        (request.auth != null && isOwner(resource.data.creatorId));
      allow create: if request.auth != null &&
        isOwner(request.resource.data.creatorId) &&
        request.resource.data.creatorId == request.auth.uid;
      allow update: if request.auth != null && isOwner(resource.data.creatorId) &&
        request.resource.data.creatorId == resource.data.creatorId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'salesCount', 'revenueCents', 'creatorId'
        ]);
      allow delete: if request.auth != null && isOwner(resource.data.creatorId);
    }

    // Private delivery (download URLs / course lesson URLs) — creator read only.
    // Writes go through Admin SDK (upsertStoreProduct). Buyers use getStoreAccess.
    match /storeProductContent/{productId} {
      allow read: if request.auth != null &&
        isOwner(resource.data.creatorId);
      allow write: if false;
    }

    match /storePurchases/{purchaseId} {
      allow read: if request.auth != null && isOwner(resource.data.creatorId);
      allow write: if false;
    }

    // Store seller review queue — Admin SDK / callables only
    match /storeSellerReviews/{uid} {
      allow read, write: if false;
    }
  }
}
