{
  "name": "@verza/mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "Verza MCP server — Optic discovery, campaign budgets, and predicted ROAS for AI agents",
  "type": "module",
  "bin": {
    "verza-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "dev:dev": "VERZA_ENV=verza-canvas-dev tsx watch src/index.ts",
    "dev:prod": "VERZA_ENV=verza-canvas tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:dev": "VERZA_ENV=verza-canvas-dev node dist/index.js",
    "start:prod": "VERZA_ENV=verza-canvas node dist/index.js",
    "start:http": "VERZA_MCP_TRANSPORT=http node dist/index.js",
    "start:http:dev": "VERZA_ENV=verza-canvas-dev VERZA_MCP_TRANSPORT=http node dist/index.js",
    "start:http:prod": "VERZA_ENV=verza-canvas VERZA_MCP_TRANSPORT=http node dist/index.js",
    "deploy:dev": "bash scripts/deploy-cloud-run.sh verza-canvas-dev",
    "deploy:prod": "bash scripts/deploy-cloud-run.sh verza-canvas",
    "typecheck": "tsc --noEmit",
    "check:math": "node --import tsx scripts/check-math.mts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.25.0",
    "cheerio": "^1.0.0",
    "dotenv": "^16.5.0",
    "firebase-admin": "^13.4.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4"
  }
}
