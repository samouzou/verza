{
  "name": "@verza/desktop",
  "version": "1.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsc && electron .",
    "start": "electron .",
    "build": "tsc",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@types/node": "^25.7.0",
    "dotenv": "^17.4.2",
    "firebase-admin": "^13.9.0",
    "playwright": "^1.60.0",
    "tsx": "^4.21.0",
    "twilio": "^6.0.2",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.verza.optic",
    "productName": "Verza Optic",
    "files": [
      "dist/**/*",
      "index.html",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.business",
      "target": ["dmg", "zip"]
    },
    "win": {
      "target": ["nsis"]
    },
    "linux": {
      "target": ["AppImage"]
    }
  }
}
